{
	"name": "@softistx/riva-rest",
	"version": "0.0.0",
	"description": "REST transport for riva, typed by OpenAPI through openapi-httpyz, with a free fetcher for schema-less APIs.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"state",
		"signals",
		"cache",
		"graphql",
		"rest",
		"ssr"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/riva.git",
		"directory": "packages/riva-rest"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "bun check"
	},
	"devDependencies": {
		"@types/bun": "^1.4.5"
	},
	"peerDependencies": {
		"@softistx/riva": "^0.0.0",
		"@softistx/httpyz": "^0.6.1",
		"@softistx/openapi-httpyz": "^0.4.1"
	},
	"peerDependenciesMeta": {
		"@softistx/openapi-httpyz": {
			"optional": true
		}
	}
}
