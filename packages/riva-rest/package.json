{
	"name": "@softistx/riva-rest",
	"version": "0.9.0",
	"description": "REST transport for riva, typed by OpenAPI through openapi-httpyz, with a free fetcher for schema-less APIs.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./entities": {
			"types": "./dist/entities/index.d.ts",
			"import": "./dist/entities/index.js",
			"default": "./dist/entities/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js",
			"default": "./dist/server/index.js"
		},
		"./bff": {
			"types": "./dist/bff/index.d.ts",
			"import": "./dist/bff/index.js",
			"default": "./dist/bff/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js",
			"default": "./dist/react/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"state",
		"signals",
		"cache",
		"graphql",
		"rest",
		"ssr"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/riva.git",
		"directory": "packages/riva-rest"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test --path-ignore-patterns 'src/react/**' src && bun test src/react",
		"typecheck": "bun check"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.0.0",
		"@softistx/httpyz": "^0.6.1",
		"@softistx/openapi-httpyz": "^0.4.1",
		"@softistx/riva": "workspace:*",
		"@softistx/riva-react": "workspace:*",
		"@types/bun": "^1.4.5",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"peerDependencies": {
		"@softistx/riva": "^0.9.0",
		"@softistx/httpyz": "^0.6.1",
		"@softistx/openapi-httpyz": "^0.4.1",
		"react": "^19.0.0",
		"@softistx/riva-react": "^0.9.0"
	},
	"peerDependenciesMeta": {
		"@softistx/openapi-httpyz": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"@softistx/riva-react": {
			"optional": true
		}
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/entities/index.ts",
			"src/server/index.ts",
			"src/bff/index.ts",
			"src/react/index.ts"
		]
	}
}
