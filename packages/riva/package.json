{
	"name": "@softistx/riva",
	"version": "0.10.0",
	"description": "Core: signals, Riva, query and mutation engine, normalized and keyed cache, pagination, optimistic layer, dehydrate and hydrate. Pure TypeScript, no DOM, no React.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./entities": {
			"types": "./dist/entities/index.d.ts",
			"import": "./dist/entities/index.js",
			"default": "./dist/entities/index.js"
		},
		"./infinite": {
			"types": "./dist/infinite/index.d.ts",
			"import": "./dist/infinite/index.js",
			"default": "./dist/infinite/index.js"
		},
		"./ssr": {
			"types": "./dist/ssr/index.d.ts",
			"import": "./dist/ssr/index.js",
			"default": "./dist/ssr/index.js"
		},
		"./store": {
			"types": "./dist/store/index.d.ts",
			"import": "./dist/store/index.js",
			"default": "./dist/store/index.js"
		},
		"./resource": {
			"types": "./dist/resource/index.d.ts",
			"import": "./dist/resource/index.js",
			"default": "./dist/resource/index.js"
		},
		"./data": {
			"types": "./dist/data/index.d.ts",
			"import": "./dist/data/index.js",
			"default": "./dist/data/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"state",
		"signals",
		"cache",
		"graphql",
		"rest",
		"ssr"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/riva.git",
		"directory": "packages/riva"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "bun check"
	},
	"devDependencies": {
		"@types/bun": "^1.4.5"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/entities/index.ts",
			"src/infinite/index.ts",
			"src/ssr/index.ts",
			"src/data/index.ts",
			"src/store/index.ts",
			"src/resource/index.ts"
		]
	}
}
