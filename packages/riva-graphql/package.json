{
	"name": "@softistx/riva-graphql",
	"version": "0.0.0",
	"description": "GraphQL transport for riva over @softistx/graphql-client, with persisted ids and the allowlist codegen plugin.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./infinite": {
			"types": "./dist/infinite/index.d.ts",
			"import": "./dist/infinite/index.js",
			"default": "./dist/infinite/index.js"
		},
		"./codegen": {
			"types": "./dist/codegen/index.d.ts",
			"import": "./dist/codegen/index.js",
			"default": "./dist/codegen/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"state",
		"signals",
		"cache",
		"graphql",
		"rest",
		"ssr"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/riva.git",
		"directory": "packages/riva-graphql"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "bun check"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "^8.0.0",
		"@graphql-codegen/client-preset": "^7.0.0",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@softistx/graphql-client": "^0.9.0",
		"@softistx/riva": "workspace:*",
		"@types/bun": "^1.4.5",
		"graphql": "^17.0.0"
	},
	"peerDependencies": {
		"@softistx/riva": "^0.0.0",
		"@softistx/graphql-client": "^0.9.0",
		"@graphql-typed-document-node/core": "^3.2.0",
		"graphql": "^16.11.0 || ^17.0.0"
	},
	"peerDependenciesMeta": {
		"@graphql-typed-document-node/core": {
			"optional": true
		},
		"graphql": {
			"optional": true
		}
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/infinite/index.ts",
			"src/codegen/index.ts"
		]
	}
}
