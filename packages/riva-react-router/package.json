{
	"name": "@softistx/riva-react-router",
	"version": "0.7.2",
	"description": "React Router host for riva: one Riva per request with an ambient scope, SSR dehydrate and hydrate through loader data, and a merge on each navigation.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./dist/server/index.js"
	],
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js",
			"default": "./dist/server/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"state",
		"signals",
		"cache",
		"graphql",
		"rest",
		"ssr"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/riva.git",
		"directory": "packages/riva-react-router"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "bun check"
	},
	"devDependencies": {
		"@graphql-typed-document-node/core": "^3.2.0",
		"@happy-dom/global-registrator": "^20.0.0",
		"@softistx/riva": "workspace:*",
		"@softistx/riva-graphql": "workspace:*",
		"@softistx/riva-react": "workspace:*",
		"@softistx/riva-rest": "workspace:*",
		"@types/bun": "^1.4.5",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.0.0",
		"graphql": "^17.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "^8.5.3"
	},
	"peerDependencies": {
		"@softistx/riva": "^0.7.2",
		"@softistx/riva-react": "^0.7.2",
		"react": "^19.0.0",
		"react-router": "^8.0.0",
		"@softistx/alxia-react-router": "^0.83.1"
	},
	"peerDependenciesMeta": {
		"@softistx/alxia-react-router": {
			"optional": true
		}
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/server/index.ts"
		]
	}
}
