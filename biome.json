{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "develop"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/dist",
			"!**/generated",
			"!**/mails",
			"!!.claude/worktrees"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"markdown": { "formatter": { "enabled": false } },
	"yaml": { "formatter": { "enabled": false } },
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				"noArrayIndexKey": "off",
				"useAdjacentOverloadSignatures": "off"
			},
			"complexity": {
				"noArguments": "off",
				"useLiteralKeys": "off"
			},
			"style": {
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": { "kind": "typeProperty" },
								"formats": ["camelCase"]
							},
							{
								"selector": { "kind": "typeMethod" },
								"formats": ["camelCase"]
							},
							{
								"selector": { "kind": "classProperty" },
								"formats": ["camelCase"]
							},
							{
								"selector": { "kind": "classMethod" },
								"formats": ["camelCase"]
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/test/types/**", "**/*.test-d.ts"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": "off"
					}
				}
			}
		}
	]
}
